# 构建上下文排除项。镜像里只需要 app/ + static/ + alembic/ + 依赖清单，
# 其余（版本控制、虚拟环境、测试、上传文件、设计文档）都不该进镜像。

# 版本控制与编辑器
.git/
.gitignore
.github/
.trae/
.workbuddy/
*.swp

# 虚拟环境与缓存
.venv/
__pycache__/
*.py[codz]
.ruff_cache/
.pytest_cache/

# 测试与工具（运行时不需要；CI 里单独跑）
tests/

# 运行时产物：上传的原始文件与日志
data/
*.log

# 设计文档
design_docs/

# 本地环境变量（含密钥，绝不能进镜像）
.env
.env.*
!.env.example

# 开发机的数据库文件
*.db
