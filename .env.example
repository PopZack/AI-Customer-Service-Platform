# ── 应用基础 ──
APP_NAME=企业 AI 客服平台
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# ── 数据库(第 10 阶段启用)──
# 生产环境(PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# 本地开发可临时用 SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./ai_customer_service.db
DATABASE_URL=

# ── Redis(第 12 阶段启用)──
# 格式:redis://localhost:6379/0
REDIS_URL=

# ── JWT(第 11 阶段启用,第 12 阶段调整:access 缩短 + refresh)──
# 生产请用 openssl rand -hex 32 生成强随机串
JWT_SECRET=dev_change_me_please_use_32_chars_at_least
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 限流(第 12 阶段启用)──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ROUTES=/api/v1/auth/login,/api/v1/auth/register
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ── LLM(第 13 阶段启用)──
# OpenAI 兼容接口,换 base_url 即可切换厂商:
# DeepSeek:   https://api.deepseek.com/v1, model=deepseek-chat
# Qwen:       https://dashscope.aliyuncs.com/compatible-mode/v1, model=qwen-plus
# Moonshot:   https://api.moonshot.cn/v1, model=moonshot-v1-8k
# 豆包:       https://ark.cn-beijing.volces.com/api/v3, model=<endpoint_id>
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30
